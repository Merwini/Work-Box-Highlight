<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Configurations>Release</Configurations>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">$(MSBuildProjectDirectory)/../../../..</RimWorldDir>
    <LangVersion>12.0</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Optimize>true</Optimize>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <Target Name="ValidateModReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(RimWorldDir)/Assembly-CSharp.dll')" Text="RimWorld assemblies not found. Set RimWorldDir to your RimWorld installation using -p:RimWorldDir=... ." />
  </Target>
</Project>
